{
  "name": "dpm-lol",
  "version": "0.2.0",
  "private": true,
  "description": "League player stats, OP.GG builds and a minimal in-game overlay.",
  "author": "DPM.lol",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/desktop-test.cjs",
    "dist": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "refresh:data": "node scripts/refresh-data.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "electron-updater": "6.8.9",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "build": {
    "appId": "local.rift.companion",
    "productName": "DPM.lol",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "DPM.lol.exe",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "icon": "public/dpm.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DPM.lol-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "Falafel312",
      "repo": "Danielsamlauncherxoxo",
      "releaseType": "release"
    }
  }
}
